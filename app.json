{
  "expo": {
    "name": "RAINCHECK",
    "slug": "consumer-mobile-hack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sarmishta.consumermobilehack"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "consumermobilehack",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "RAINCHECK uses your photos so you can share check-in and hangout pictures with your crew.",
          "cameraPermission": "RAINCHECK uses your camera so you can snap check-in and hangout pictures for your crew."
        }
      ],
      "expo-font"
    ],
    "backgroundColor": "#F2F2F7"
  }
}
